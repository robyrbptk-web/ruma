# Salin file ini menjadi .env lalu isi dengan kredensial milikmu.
# JANGAN commit file .env.

# Supabase → Project Settings → API
# Boleh memakai service_role key lama (JWT) atau Secret key baru (sb_secret_...).
SUPABASE_URL=https://PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Opsional untuk skrip lokal (schema/migrasi). Tidak dibaca oleh /api/ruma.
SUPABASE_DB_URL=postgresql://postgres.PROJECT-REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Nama bucket Storage untuk foto/video (dibuat oleh supabase/schema.sql)
SUPABASE_MEDIA_BUCKET=ruma-media

# Cloudflare Turnstile → dashboard Turnstile → widget → Secret Key
# Kosongkan hanya untuk pengembangan lokal; di produksi wajib diisi.
TURNSTILE_SECRET_KEY=

# Opsional: batasi hostname yang boleh memakai token Turnstile.
# Pisahkan dengan koma, contoh: ruma.vercel.app,ruma.id
TURNSTILE_HOSTNAMES=
